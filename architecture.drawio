    <mxCell id="53" value="🚪 Door State Machine&lt;br&gt;DOOR_CLOSED → DOOR_OPENING&lt;br&gt;→ DOOR_OPEN → DOOR_CLOSING&lt;br&gt;Map cell stays 'D' always.&lt;br&gt;Passability check:&lt;br&gt;  is_blocked: D + !OPEN → blocked&lt;br&gt;  DDA: D + OPEN → ray passes through" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="24">
      <mxGeometry x="680" y="505" width="250" height="125" as="geometry" />
    </mxCell>

    <mxCell id="53b" value="🎯 Combat Hit Detection&lt;br&gt;shoot() → find_target()&lt;br&gt;  dot product: fwd = dx·dir_x + dy·dir_y&lt;br&gt;  lat = dx·(-dir_y) + dy·dir_x&lt;br&gt;  hit if: fwd &gt; 0 &amp;amp;&amp;amp; fwd &lt; range&lt;br&gt;         &amp;amp;&amp;amp; |lat| &lt; radius&lt;br&gt;Weapon: machete=short/wide, gun=long/narrow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#5c6bc0;fontSize=10;align=left;" vertex="1" parent="24">
      <mxGeometry x="680" y="650" width="270" height="130" as="geometry" />
    </mxCell>

    <!-- DDA fog note -->
    <mxCell id="54" value="🌫 Distance Fog (DOOM colormap-inspired)&lt;br&gt;fog_q8 = (int)( clamp(1 - (dist-FOG_START)&lt;br&gt;              /(FOG_END-FOG_START), FOG_FLOOR, 1.0)&lt;br&gt;            * light_mult * 256 )&lt;br&gt;Computed once per column (not per pixel)&lt;br&gt;shade: r = (r * fog_q8) &gt;&gt; 8  ← integer only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#d79b00;fontSize=10;align=left;" vertex="1" parent="24">
