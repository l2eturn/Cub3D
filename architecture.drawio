    <!-- ===== SECTION 6: DESIGN PRINCIPLES ===== -->
    <mxCell id="80" value="⑥ Design Principles" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=12;fontColor=#006EAF;" vertex="1" parent="1">
      <mxGeometry x="20" y="1132" width="250" height="22" as="geometry" />
    </mxCell>

    <mxCell id="81" value="① One header (cub3d.h)   — all structs + defines + prototypes. Every .c includes only this.&lt;br&gt;② t_game = god struct     — all state in one place, passed by pointer everywhere, no hidden globals.&lt;br&gt;③ Single exit point       — cleanup_exit(game, msg) frees everything then calls exit(). Every error path calls it.&lt;br&gt;④ memset(&amp;amp;game, 0)      — at program start. Safe to free partially-initialized struct on error.&lt;br&gt;⑤ Parse → validate → render — never enter render loop with invalid map state.&lt;br&gt;⑥ Flag pattern for input  — hooks set flags on t_player. update_player() consumes flags each frame." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#3f51b5;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="20" y="1158" width="820" height="110" as="geometry" />
    </mxCell>

    <!-- .cub format -->
    <mxCell id="82" value=".cub File Format" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=12;fontColor=#006EAF;" vertex="1" parent="1">
      <mxGeometry x="860" y="1132" width="200" height="22" as="geometry" />
    </mxCell>

    <mxCell id="83" value="NO ./textures/north.png   ← path to wall texture&lt;br&gt;SO ./textures/south.png   (NO2/SO2/WE2/EA2 = wall type 2)&lt;br&gt;WE ./textures/west.png&lt;br&gt;EA ./textures/east.png&lt;br&gt;F 34,34,34              ← floor RGB&lt;br&gt;C 0,0,0                ← ceiling RGB&lt;br&gt;&lt;br&gt;1 1 1 1 1 1&lt;br&gt;1 0 N 0 D 1    N/S/E/W = player spawn+dir&lt;br&gt;1 0 0 0 0 1    D = door, H = heal, A = ammo&lt;br&gt;1 G 0 X 0 1    G = ghost, X = exit&lt;br&gt;1 1 1 1 1 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=10;align=left;fontFamily=Courier New;" vertex="1" parent="1">
      <mxGeometry x="860" y="1158" width="380" height="170" as="geometry" />
    </mxCell>

