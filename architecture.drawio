        <mxCell id="74" parent="73" style="text;html=1;align=left;verticalAlign=top;fontSize=10;" value="render_frame.c  — per-frame orchestrator&lt;br&gt;render_wall.c   — tex sample + fog Q8 shade&lt;br&gt;render_flat.c   — floor/ceiling solid fill&lt;br&gt;texture_load.c  — PNG → mlx_image (4-type fallback)" vertex="1">
