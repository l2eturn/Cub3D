      <mxGeometry x="8" y="28" width="254" height="95" as="geometry" />
    </mxCell>

    <!-- MLX42 external -->
    <mxCell id="79" value="&lt;b&gt;MLX42  (../MLX42/)&lt;/b&gt;&lt;br&gt;cmake -B build → libmlx42.a&lt;br&gt;OpenGL + GLFW backend&lt;br&gt;mlx_init / mlx_loop / mlx_image_t&lt;br&gt;key/mouse/close hooks&lt;br&gt;&lt;br&gt;&lt;b&gt;macOS link:&lt;/b&gt;&lt;br&gt;-framework Cocoa -framework OpenGL&lt;br&gt;-framework IOKit -lglfw -lm&lt;br&gt;&lt;b&gt;Linux link:&lt;/b&gt;&lt;br&gt;-lglfw -ldl -pthread -lm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="1510" y="840" width="270" height="155" as="geometry" />
