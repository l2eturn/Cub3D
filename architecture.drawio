        <mxCell id="72" parent="71" style="text;html=1;align=left;verticalAlign=top;fontSize=10;" value="raycast.c — DDA algorithm (4 functions):&lt;br&gt;  init_ray()       — camera_x → ray_dir&lt;br&gt;  init_step()      — side_dist, delta_dist&lt;br&gt;  perform_dda()    — step grid until wall hit&lt;br&gt;  calc_wall_data() — perp_dist → line_h, tex_x" vertex="1">
