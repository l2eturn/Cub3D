        </mxCell>
        <mxCell id="76" parent="75" style="text;html=1;align=left;verticalAlign=top;fontSize=10;" value="door.c       — state FSM + slide anim&lt;br&gt;minimap.c    — top-left tile overlay&lt;br&gt;mouse.c      — poll + warp cursor lock&lt;br&gt;sprite.c     — Z-buffer renderer (Wolf3D Q16)&lt;br&gt;gun.c        — weapon overlay + bob + recoil&lt;br&gt;hud.c        — HP/stamina bars, crosshair&lt;br&gt;combat.c     — shoot(), vector hit detect&lt;br&gt;vignette.c   — edge darkening (step=2)&lt;br&gt;menu.c       — title screen + FSM&lt;br&gt;ghost_ai.c   — chase + sin wobble&lt;br&gt;pickups.c    — consume + 10s respawn&lt;br&gt;restart.c    — full state reset (R key)&lt;br&gt;sound.c      — afplay/aplay wrappers&lt;br&gt;audio.c      — music loop + lighting flicker&lt;br&gt;highscore.c  — read/write highscore.txt&lt;br&gt;dialog.c     — subtitle timer state&lt;br&gt;npc.c        — warden dialog + unlock&lt;br&gt;jumpscare.c  — trigger + anim frames&lt;br&gt;cheat.c      — god mode input buffer&lt;br&gt;settings.c   — sens / difficulty UI" vertex="1">
          <mxGeometry height="425" width="254" x="8" y="30" as="geometry" />
        </mxCell>
        <mxCell id="77" parent="1" style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;align=center;" value="src/utils/ + src/cleanup/" vertex="1">
          <mxGeometry height="130" width="270" x="1510" y="695" as="geometry" />
        </mxCell>
        <mxCell id="78" parent="77" style="text;html=1;align=left;verticalAlign=top;fontSize=10;" value="gnl.c      — get_next_line (static 1024B buf)&lt;br&gt;utils.c    — ft_strlen/strdup/split/atoi/…&lt;br&gt;cleanup.c  — single exit point&lt;br&gt;             free all → exit()&lt;br&gt;             every error path calls this" vertex="1">
          <mxGeometry height="95" width="254" x="8" y="28" as="geometry" />
        </mxCell>
        <mxCell id="79" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;" value="&lt;b&gt;MLX42  (../MLX42/)&lt;/b&gt;&lt;br&gt;&lt;hr/&gt;cmake -B build → libmlx42.a&lt;br&gt;OpenGL + GLFW backend&lt;br&gt;mlx_init / mlx_loop / mlx_image_t&lt;br&gt;&lt;br&gt;&lt;b&gt;macOS:&lt;/b&gt; -framework Cocoa/OpenGL/IOKit&lt;br&gt;&lt;b&gt;Linux:&lt;/b&gt; -ldl -pthread -lglfw" vertex="1">
          <mxGeometry height="145" width="270" x="1510" y="840" as="geometry" />
        </mxCell>
        <mxCell id="80" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#006EAF;" value="⑥ Design Principles" vertex="1">
          <mxGeometry height="22" width="250" x="20" y="1132" as="geometry" />
        </mxCell>
        <mxCell id="81" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e8eaf6;strokeColor=#3f51b5;fontSize=10;" value="&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;① One header (cub3d.h)        — all structs + defines + prototypes. Every .c includes only this.&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;② t_game = god struct           — all state in one place, passed by pointer everywhere, no hidden globals.&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;③ Single exit point             — cleanup_exit(game, msg) frees everything then calls exit(). Every error path calls it.&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;④ memset(&amp;amp;game, 0) at start  — safe to free partially-initialized struct on any early error.&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;⑤&amp;nbsp;Parse → validate → render    — never enter render loop with invalid map state.&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;⑥ Flag pattern for input        — hooks set flags on t_player. update_player() consumes flags each frame." vertex="1">
          <mxGeometry height="110" width="820" x="20" y="1158" as="geometry" />
        </mxCell>
        <mxCell id="82" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#006EAF;" value=".cub File Format" vertex="1">
          <mxGeometry height="22" width="200" x="860" y="1132" as="geometry" />
        </mxCell>
        <mxCell id="83" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#f3e5f5;strokeColor=#9673a6;fontSize=10;fontFamily=Courier New;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;NO ./textures/north.png   ← wall texture path&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;SO ./textures/south.png   (NO2/SO2 = wall type 2)&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;WE ./textures/west.png&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;EA ./textures/east.png&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;F 34,34,34     ← floor RGB&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;C 0,0,0        ← ceiling RGB&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;1 1 1 1 1 1&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;1 0 N 0 D 1    N=player spawn, D=door&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;1 G 0 X 0 1    G=ghost, X=exit, H=heal, A=ammo&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;1 1 1 1 1 1&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="380" x="860" y="1158" as="geometry" />
        </mxCell>
        <mxCell id="84" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#006EAF;" value="Build &amp;amp; Run" vertex="1">
          <mxGeometry height="22" width="150" x="1260" y="1132" as="geometry" />
        </mxCell>
        <mxCell id="85" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#e8f5e9;strokeColor=#4caf50;fontSize=10;fontFamily=Courier New;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;cd project_ref_mac      # macOS&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;cd making-ref           # Linux&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;make&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;./cub3D resource/maps/abyss.cub&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;make clean / fclean / re&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;Prereqs macOS:  brew install glfw&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;Prereqs Linux:  apt install libglfw3-dev&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="420" x="1260" y="1158" as="geometry" />
        </mxCell>
        <mxCell id="86" edge="1" parent="1" source="24" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#d6b656;exitX=0.5;exitY=1;" target="56" value="reads/writes">
          <mxGeometry relative="1" as="geometry" />
